# 仙度瑞拉記帳 — 環境變數範本
#
# 本機：複製成 .env.local 再填值（.env.local 已被 .gitignore 排除，不會上傳到 GitHub）
# Vercel：到 Project → Settings → Environment Variables 逐一新增
#
# 每一項怎麼取得，請看 README.md 的「第一次設定」。

# 簽署登入 cookie 用的金鑰，至少 32 個字元。產生方式：openssl rand -base64 32
AUTH_SECRET=

# 網站對外網址（不含結尾斜線）。本機可留空；上線後填 Vercel 網址，例如 https://cinderella-ledger.vercel.app
APP_URL=

# 允許登入的 Gmail，用逗號分隔。名單外的人一律無法登入；留空 = 沒有人能登入。
ALLOWED_EMAILS=

# Google 登入（Google Cloud Console → API 和服務 → 憑證 → OAuth 用戶端 ID）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 寫入 Google 試算表用的服務帳號（Google Cloud Console → IAM → 服務帳號 → 金鑰 → JSON）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 貼上 JSON 檔裡的 private_key，整段用雙引號包起來，保留裡面的 \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 帳本試算表的 ID：網址 https://docs.google.com/spreadsheets/d/<這一段>/edit
GOOGLE_SHEET_ID=
